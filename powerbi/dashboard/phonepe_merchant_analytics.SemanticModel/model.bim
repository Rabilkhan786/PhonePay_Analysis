          },
          {
            "name": "Merchants",
            "dataType": "int64",
            "sourceColumn": "Merchants",
            "summarizeBy": "none"
          },
          {
            "name": "Transactions",
            "dataType": "int64",
            "sourceColumn": "Transactions",
            "summarizeBy": "none"
          },
          {
            "name": "Merchants per 100K Users",
            "dataType": "double",
            "sourceColumn": "Merchants per 100K Users",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "State Opportunities",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/state_opportunities.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"State\", type text}, {\"State Rank\", Int64.Type}, {\"State Score\", type number}, {\"Eligible Districts\", Int64.Type}, {\"Expand Districts\", Int64.Type}, {\"Users\", Int64.Type}, {\"Merchants\", Int64.Type}, {\"Transactions\", Int64.Type}, {\"Merchants per 100K Users\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "State Opportunity Score",
            "expression": "MAX('State Opportunities'[State Score])",
            "formatString": "0.0",
            "description": ""
          }
        ]
      },
      {
        "name": "Recommendations",
        "columns": [
          {
            "name": "District Key",
            "dataType": "string",
            "sourceColumn": "District Key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Priority",
            "dataType": "int64",
            "sourceColumn": "Priority",
            "summarizeBy": "none"
          },
          {
            "name": "Score",
            "dataType": "double",
            "sourceColumn": "Score",
