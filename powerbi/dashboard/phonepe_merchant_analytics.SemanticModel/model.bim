            "name": "Alternative Rank",
            "dataType": "int64",
            "sourceColumn": "Alternative Rank",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Recommendations",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/recommendations.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"District Key\", type text}, {\"Priority\", Int64.Type}, {\"Score\", type number}, {\"YoY Growth\", type number}, {\"Users per Merchant\", type number}, {\"Merchants\", Int64.Type}, {\"Segment\", type text}, {\"Positive YoY Quarters\", Int64.Type}, {\"Action\", type text}, {\"Alternative Rank\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Shortlist Score",
            "expression": "MAX(Recommendations[Score])",
            "formatString": "0.0",
            "description": ""
          },
          {
            "name": "Shortlist YoY",
            "expression": "MAX(Recommendations[YoY Growth])",
            "formatString": "0.0%",
            "description": ""
          }
        ]
      }
    ],
    "relationships": [
      {
